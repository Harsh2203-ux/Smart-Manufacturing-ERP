# ─── Smart Manufacturing ERP — Frontend environment variables ─────────────────
#
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# ── API ────────────────────────────────────────────────────────────────────────
# Base URL of the backend REST API (no trailing slash)
VITE_API_URL=http://localhost:5001/api

# ── Development Demo Mode ─────────────────────────────────────────────────────
# Set to "true" to enable the "🚀 Enter Demo Mode" button on the login page.
#
# SAFETY: This variable has ZERO effect in production builds.
# Vite statically replaces import.meta.env.MODE with "production" during
# `vite build`, making the DEMO_MODE constant evaluate to false and causing
# the entire demo branch to be dead-code-eliminated by the bundler.
#
# Only works when running `vite dev` (MODE === "development").
VITE_DEMO_MODE=true
