# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
API_VERSION=v1

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Replace with your actual MongoDB URI (local or Atlas)
MONGO_URI=mongodb+srv://hhdave322_db_user:Harsh_2005@smartmanufacturingerp.vtdpzm7.mongodb.net/smart_manufacturing_erp?retryWrites=true&w=majority&appName=SmartManufacturingERP

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=smart_mfg_erp_jwt_secret_change_in_production_must_be_64_chars_minimum
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=smart_mfg_erp_refresh_secret_change_in_production_different_key
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECRET=smart_mfg_erp_cookie_secret_change_in_production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
