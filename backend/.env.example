# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Replace <username>, <password>, <cluster>, <dbname> with your Atlas values
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_at_least_64_random_chars_secret_key_here
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_with_different_64_random_chars_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production on Render, set this to your Vercel deployment URL(s).
# Example production value:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECRET=replace_with_32_random_chars_cookie_secret
# In production on Render, set COOKIE_SECURE=true and COOKIE_SAME_SITE=none
# (none is required for cross-site cookies between Vercel and Render)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=
# Use onboarding@resend.dev for initial testing (no domain verification needed)
# For production, use a verified sender address from your domain
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Smart Manufacturing ERP

# ─── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─── Frontend URL (for email links) ───────────────────────────────────────────
# In production on Render, set this to your Vercel deployment URL
# FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
