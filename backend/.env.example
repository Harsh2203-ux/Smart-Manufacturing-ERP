# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Replace <username>, <password>, <cluster>, <dbname> with your Atlas values
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_at_least_64_random_chars_secret_key_here
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_with_different_64_random_chars_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECRET=replace_with_32_random_chars_cookie_secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
EMAIL_FROM_NAME=Smart Manufacturing ERP
EMAIL_FROM_ADDRESS=noreply@erp.local

# ─── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─── Frontend URL (for email links) ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
