# ─── Smart Manufacturing ERP — Backend Environment Variables ──────────────────
#
# Copy this file to .env and fill in your actual values.
# .env is git-ignored and MUST NEVER be committed.
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Railway sets PORT automatically — do NOT hardcode this in Railway dashboard
PORT=5000
API_VERSION=v1

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Replace <username>, <password>, <cluster>, <dbname> with your Atlas values.
# Atlas → Network Access → add 0.0.0.0/0 for Railway (dynamic IPs).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_at_least_64_random_chars_secret_key_here
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_with_different_64_random_chars_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (exact match, no wildcards).
# Railway production: set this to your Vercel deployment URL.
# Example:
#   CORS_ORIGINS=https://your-app.vercel.app
# For local development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#
# Optional: regex patterns for Vercel preview deployments (comma-separated).
# Example: CORS_ORIGIN_PATTERNS=https://.*\.vercel\.app$
CORS_ORIGIN_PATTERNS=

# ─── Cookie ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace_with_32_random_chars_cookie_secret
# Production (cross-site: Vercel → Railway): COOKIE_SECURE=true, COOKIE_SAME_SITE=none
# Local development: COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ─── Email Provider ────────────────────────────────────────────────────────────
# smtp  → Nodemailer/SMTP (required for Railway — outbound SMTP is allowed)
# resend → Resend API (optional, for future use)
EMAIL_PROVIDER=smtp

# ─── SMTP (Nodemailer) — used when EMAIL_PROVIDER=smtp ─────────────────────────
# Example using Gmail with App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false    (false = STARTTLS on port 587; true = TLS on port 465)
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   (Gmail App Password — NOT your account password)
#
# Other providers: Outlook/Hotmail, Yahoo, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.smtp.address@gmail.com
SMTP_PASS=your_smtp_app_password_here

# ─── Sender identity ───────────────────────────────────────────────────────────
EMAIL_FROM_NAME=Smart Manufacturing ERP
EMAIL_FROM_ADDRESS=your.smtp.address@gmail.com

# ─── Resend (optional — only needed when EMAIL_PROVIDER=resend) ────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=Smart Manufacturing ERP

# ─── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─── Frontend URL (used in email links: verify, reset password) ────────────────
# Set to your Vercel production URL:
#   FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
